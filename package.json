{
  "name": "ngx-monaco-editor-v2",
  "version": "22.0.4",
  "description": "Monaco Code Editor For Angular",
  "keywords": [
    "angular",
    "monaco",
    "monaco-editor-v2",
    "code",
    "editor",
    "reusable"
  ],
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "run-s build-editor serve",
    "serve": "ng serve",
    "build": "ng build --project=editor-tester --base-href=editor-tester --configuration=development",
    "build:prod": "ng build --project=editor-tester --base-href=editor-tester",
    "lint": "ng lint",
    "test": "ng test editor-tester --no-watch",
    "e2e": "ng e2e",
    "build-and-deploy-demo": "npm run build:prod && shx cp dist/editor-tester/browser/index.html dist/editor-tester/browser/200.html && cd dist/editor-tester/browser && surge --domain ngx-monaco-editor-v2.surge.sh",
    "copy:200": "shx cp dist/editor-tester/browser/index.html dist/editor-tester/browser/200.html",
    "deploy:demo": "surge dist/editor-tester/browser --domain ngx-monaco-editor-v2.surge.sh",
    "build-and-deploy-demo:win": "run-s build:prod copy:200 deploy:demo",
    "build-editor": "npm run copy:readme && ng build editor",
    "npm-publish": "npm run build-editor && npm publish ./dist/editor --access public",
    "copy:readme": "shx cp -f README.md projects/editor/"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/miki995/ngx-monaco-editor-v2.git"
  },
  "bugs": {
    "url": "https://github.com/miki995/ngx-monaco-editor-v2/issues"
  },
  "author": "Miroslav Maksimovic",
  "contributors": [
    "Atul Kumar <atulaggarwal4288@gmail.com>",
    "Miroslav Maksimovic <miroslavmaksimovic95@gmail.com>",
    "Thomas-Louis Simard <thomas.louis.simard@gmail.com>"
  ],
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "monaco-editor": "^0.55.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "22.0.4",
    "@angular/compiler-cli": "22.0.4",
    "@angular/language-service": "22.0.4",
    "@types/node": "^24.0.3",
    "happy-dom": "^20.10.6",
    "istanbul-lib-instrument": "^6.0.3",
    "ng-packagr": "^22.0.0",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
